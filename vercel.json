{
  "version": 2,
  "buildCommand": "cd riskpulse && node scripts/build.mjs",
  "outputDirectory": "riskpulse/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/dashboard.html"
    },
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}