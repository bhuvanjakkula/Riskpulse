{
  "version": 2,
  "buildCommand": "cd riskpulse && node scripts/build.mjs",
  "outputDirectory": "riskpulse/dist",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/app",
      "dest": "/app.html"
    },
    {
      "src": "/plans",
      "dest": "/plans.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}